{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    // Same reasoning as `packages/routing`'s own tsconfig — `tsup` reads
    // this file to build the published declaration output, and `stripInternal`
    // keeps a declaration tagged compiler-internal out of `dist/index.d.ts`.
    // `tsconfig.typecheck.json` (used by
    // `type-check:test`) extends this file but stays unaffected: it is
    // `noEmit`, so `stripInternal` — a declaration-emit option — has no
    // effect there.
    "stripInternal": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
